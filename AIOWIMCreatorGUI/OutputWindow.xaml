<Window x:Class="AIOWIMCreatorGUI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Progress" Height="400" Width="500">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Progress:"/>
            <ProgressBar x:Name="ProgressBar" Height="20" Margin="0,0,0,10" IsIndeterminate="True"/>
            <TextBox x:Name="ProgressTextBox" IsReadOnly="True" Height="300" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>