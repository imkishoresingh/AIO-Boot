<Window x:Class="AIOWIMCreatorGUI.SelectImagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Windows Editions" Height="400" Width="500">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Available Editions in the WIM/ESD file:" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="ImagesListBox" Height="250" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="OK" Click="OKButton_Click" Width="80" Margin="0,0,10,0"/>
                <Button Content="Cancel" Click="CancelButton_Click" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>